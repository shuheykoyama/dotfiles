[include]
	path = ~/.config/git/delta/themes/kanagawa_dragon.gitconfig
	path = ~/.config/git/delta/themes/solarized_dark_vivid.gitconfig
[user]
	name = shuheykoyama
	email = shuheykoyama@gmail.com
	signingkey = /Users/shuhey/.ssh/id_ed25519_github
[core]
	excludesfile = ~/.gitignore
	editor = nvim
	pager = delta
[color]
	ui = auto
[hub]
	protocol = ssh
[github]
	user = shuheykoyama
[diff]
	colorMoved = default
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
	side-by-side = true
	true-color = always
	features = kanagawa-dragon
[merge]
	conflictstyle = diff3
[init]
	defaultBranch = main
[alias]
	alias = !git config --list | grep ^alias\\.
	st = status
	sw = switch
	br = branch
	bd = branch -d
	co = checkout
	cb = checkout -b
[gpg]
	format = ssh
[commit]
	gpgsign = true
[ghq]
	root = /Users/shuhey/ghq
	user = shuheykoyama
