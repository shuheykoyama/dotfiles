# craftzdog/dotfiles (dot_config/git/delta.gitconfig, lazygit diffRenderers): Solarized (dark) syntax
# theme and his blue/red/green hunk-header and commit-decoration colours. His layout options (file-style
# omit, commit-style raw, hunk-header-style) are not adopted; side-by-side, line-numbers and navigate
# stay as set in git/config. Selected by DELTA_FEATURES from fish/config/delta.fish.
[delta "solarized-dark-vivid"]
	dark = true
	syntax-theme = Solarized (dark)
	commit-decoration-style = blue ol
	hunk-header-decoration-style = blue box
	hunk-header-file-style = red
	hunk-header-line-number-style = "#067a00"
